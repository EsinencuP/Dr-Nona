# Optional comma-separated extra browser origins. Same-origin requests are
# accepted automatically, including Vercel Preview and Production deployments.
CONTACT_ALLOWED_ORIGINS=

# Canonical public origin. Vercel also supplies VERCEL_PROJECT_PRODUCTION_URL
# automatically, but this explicit value is preferred for custom domains.
SITE_URL=

# Temporary e-catalog link to the internal CRM dashboard.
# Set the deployed CRM URL in the hosting environment when it becomes available.
VITE_CRM_URL=http://127.0.0.1:3001/dashboard

# Server-only Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret token for verifying incoming Telegram webhook requests.
# Generate a random string (e.g. a UUID) and use the same value
# when registering the webhook via scripts/register-telegram-webhook.mjs.
TELEGRAM_WEBHOOK_SECRET=17e49af1-c6e5-47cc-a4f9-2a8f9ad3f610

# Local Prisma database
DATABASE_URL="file:./dev.db"
