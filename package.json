{
  "name": "dr-nona-moldova",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run runtime:generate && npm run seo:generate && vite",
    "build": "npm run runtime:generate && npm run seo:generate && npm run documentation:validate && npm run architecture:validate && npm run typography:validate && npm run market:validate && npm run content:validate && npm run claims:validate && npm run security:validate && tsc -b && vite build && node scripts/prerender-routes.mjs && npm run security:http-validate && npm run seo:validate && npm run seo:http-validate && npm run performance:validate && node scripts/generate-build-report.mjs",
    "architecture:validate": "node scripts/check-frontend-architecture.mjs",
    "claims:sync": "node scripts/sync-claims-registry.mjs",
    "claims:validate": "node scripts/check-claims-registry.mjs",
    "content:validate": "node scripts/check-product-content.mjs",
    "market:validate": "node scripts/check-market-content.mjs",
    "runtime:generate": "node scripts/generate-runtime-content.mjs",
    "seo:generate": "node scripts/generate-seo-manifest.mjs",
    "seo:validate": "node scripts/check-seo-output.mjs",
    "seo:http-validate": "node scripts/check-seo-http.mjs",
    "security:validate": "node scripts/check-security-headers.mjs",
    "security:http-validate": "node scripts/check-security-http.mjs",
    "security:runtime": "node scripts/check-csp-runtime.mjs",
    "performance:validate": "node scripts/check-performance-budget.mjs",
    "performance:runtime": "node scripts/measure-runtime-performance.mjs",
    "typography:validate": "node scripts/check-typography-accessibility.mjs",
    "documentation:validate": "node scripts/check-documentation.mjs",
    "release:status:generate": "node scripts/check-documentation.mjs --write-release",
    "repository:validate": "node scripts/check-repository-hygiene.mjs",
    "toolchain:validate": "node scripts/check-toolchain-contract.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:mobile": "playwright test --project=chromium-mobile",
    "ci": "npm run repository:validate && npm run architecture:validate && npm run typography:validate && npm run market:validate && npm run content:validate && npm run claims:validate && npm run security:validate && npm run typecheck && npm run lint && npm run test && npm run build && npm run security:runtime && npm run performance:runtime && npm run test:e2e && npm run repository:validate",
    "release:check": "npm run documentation:validate && node scripts/check-release-readiness.mjs",
    "images:import:catalog": "node scripts/import-product-card-images.mjs",
    "preview": "vite preview",
    "sync:content": "node scripts/sync-official-content.mjs stage",
    "sync:content:validate": "node scripts/sync-official-content.mjs validate",
    "sync:content:promote": "node scripts/sync-official-content.mjs promote",
    "sync:catalog:md": "node scripts/sync-moldova-catalog.mjs",
    "sync:catalog:md:write": "node scripts/sync-moldova-catalog.mjs --write"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cheerio": "^1.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.10"
  }
}
